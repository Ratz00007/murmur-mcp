{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // Unused locals and parameters fail the build. The `void x;` suppressions
    // that used to stand in for this hid genuinely dead code (an unbuilt
    // lookup map, an uncalled-for parameter, a write-only array); every one
    // was removed or renamed with a leading underscore instead.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  }
}
