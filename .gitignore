# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Dependencies (installed per workspace, never committed)
node_modules/

# Build logs / scratch output
*.log

# Local env
.env
.env.*

# Local Murmur runtime data (real demo data is sensitive and never committed)
/.murmur/
# SQLite state is never committed, wherever it lands. Previously only three
# hardcoded paths were covered, so a run in gallery/ or tools/ — or a nested
# world directory under the demo — was one `git add .` away from being
# committed. The roadmap records this having already happened once.
*.db
*.db-wal
*.db-shm
# The shipped demo is the exception: its reports, graph, and transcripts are
# deliberate evidence and ARE tracked. Only its database is regenerated by a
# replay, so exclude the whole world dir and re-include the evidence.
murmur-demo/.murmur/**

# Published tarballs are produced by CI, never committed
*.tgz

# host-llm-run: the driver and its authored brain are tracked; the run output is not
tools/host-llm-run/dump/
tools/host-llm-run/state.json

# flagship-16x8: raw Claude Code session transcripts are hook noise, not evidence
tools/flagship-16x8/**/transcript.jsonl
tools/flagship-16x8/transcript.jsonl
tools/flagship-16x8/*.jsonl

# The shipped demo's evidence is re-included last so the `murmur-demo/.murmur/**`
# exclusion above cannot swallow it. Tracked files are unaffected by .gitignore,
# but these keep a fresh regeneration addable.
!murmur-demo/.murmur/reports/
!murmur-demo/.murmur/reports/**
!murmur-demo/.murmur/*/graph.mmd
!murmur-demo/.murmur/*/audit.jsonl
!murmur-demo/.murmur/*/interviews.jsonl
!murmur-demo/.murmur/*/qa.jsonl

# Preserved original monorepo git dir (history was imported into this repo)
murmur/.git.bundle-history/
