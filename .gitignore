# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Dependencies (installed per workspace, never committed)
node_modules/

# Build logs / scratch output
*.log

# Local env
.env
.env.*

# Local Murmur runtime data (real demo data is sensitive and never committed)
/.murmur/
# The shipped demo keeps its reports/graphs/transcripts on purpose, but the
# SQLite database is regenerated by a replay and must never be committed.
murmur-demo/.murmur/*.db
murmur-demo/.murmur/*.db-wal
murmur-demo/.murmur/*.db-shm

# Published tarballs are produced by CI, never committed
*.tgz

# host-llm-run: the driver and its authored brain are tracked; the run output is not
tools/host-llm-run/dump/
tools/host-llm-run/state.json

# flagship-16x8: raw Claude Code session transcript is hook noise, not evidence
tools/flagship-16x8/transcript.jsonl

# Preserved original monorepo git dir (history was imported into this repo)
murmur/.git.bundle-history/
